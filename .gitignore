# CMake build tree(s)
build/
build*/

# clangd compile DB symlink (generated)
/compile_commands.json
.cache/

# Compiled binaries / objects
*.o
*.debug_o
/MC-DC_Simulator
/dataSynth
/debug

# Generated simulation outputs (keep the directory, ignore its contents)
instructions/demos/output/*
!instructions/demos/output/.gitkeep

# Python packaging (pip install .)
*.egg-info/
__pycache__/
mcdc/_bin/*
!mcdc/_bin/.gitkeep

# Dev-only (kept locally, excluded from the release): test suite + the legacy Makefile.
# A clean clone has no tests/, so the CMake ctest block is guarded by if(EXISTS tests/).
/tests/
/src/Makefile
# Generated API docs (regenerate from Doxyfile)
/docs/html/
/docs/latex/
