# CMake build tree(s)
build/
build*/

# clangd compile DB symlink (generated)
/compile_commands.json
.cache/

# Compiled binaries / objects
*.o
*.debug_o
/MC-DC_Simulator
/dataSynth
/debug

# Generated simulation outputs (keep the directory, ignore its contents)
instructions/demos/output/*
!instructions/demos/output/.gitkeep

# Python packaging (pip install .)
*.egg-info/
__pycache__/
mcdc/_bin/*
!mcdc/_bin/.gitkeep

# Test suite: tracked (tests/*.py, tests/accuracy with its golden references). Only the
# outputs the tests write and the dev benchmark tree (large outputs, machine-specific paths)
# stay local.
/tests/accuracy/output/
/tests/output/
/tests/benchmark/
# Old-release binaries built from this repo's history for the cross-version tests (machine-local)
/tests/crossversion/old_binaries/
/build_old/
# Legacy Makefile (dev only)
/src/Makefile
# Generated API docs (regenerate from Doxyfile)
/docs/html/
/docs/latex/
